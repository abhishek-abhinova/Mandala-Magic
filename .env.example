# Mandala Magic by OM — Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# Server
PORT=4173
HOST=0.0.0.0
NODE_ENV=development

# Session
SESSION_SECRET=change-this-to-a-random-secret

# Database (SQLite is used by default; set DATABASE_URL for MySQL in production)
# DATABASE_URL=mysql://user:password@localhost:3306/mandala_magic

# Yoycol Print-on-Demand
# — Live integration. Reverse proxy: base https://www.yoycol.com, prefix /api/2025/open/v4.
#   Credentials can also be saved (AES-256-GCM encrypted) from Admin → Settings,
#   but environment values always take precedence.
YOYCOL_API_KEY=
YOYCOL_API_SECRET=
YOYCOL_API_BASE_URL=https://www.yoycol.com
# Auth header names — per Yoycol's API contract (headers are not documented in detail).
YOYCOL_KEY_HEADER=X-Yoycol-Api-Key
YOYCOL_SECRET_HEADER=X-Yoycol-Api-Secret
# Optional HMAC shared secret for the /api/webhooks/yoycol endpoint.
# When empty, unsigned webhooks are rejected outright (webhooks not yet documented by Yoycol).
YOYCOL_WEBHOOK_SECRET=

# Payment Provider (Stripe / PayPal / Razorpay etc.)
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
PAYMENT_PUBLISHABLE_KEY=
PAYMENT_WEBHOOK_SECRET=

# Email (SMTP or transactional provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@mandalamagic.shop

# Admin
ADMIN_EMAIL=admin@mandalamagic.shop
ADMIN_PASSWORD=changeme

# Upload limits
MAX_UPLOAD_SIZE_MB=15

# Site
SITE_URL=http://localhost:4173
SITE_NAME=Mandala Magic by OM
